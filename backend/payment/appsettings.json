{
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1,1433;Database=PaymentDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30;",
    "Redis": "redis:6379,abortConnect=false,connectTimeout=5000,syncTimeout=5000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Application.Services.OutboxDispatcherHostedService": "Information"
    }
  },
  "AllowedHosts": "*",

  "Migrations": {
    "AutoMigrate": true,
    "AutoSeed": true
  },

  "Auth": {
    "Enabled": false,
    "Mode": "None",
    "RequireAdminAuth": false,
    "RequireApiAuth": false,
    "External": {
      "BaseUrl": "http://auth:8080",
      "Authority": "http://auth:8080",
      "Audience": "payment",
      "ClientId": "payment-service",
      "ClientSecret": "change-me-in-production",
      "ValidateIssuer": false,
      "ValidateAudience": false,
      "ValidateLifetime": true
    },
    "ServerUrl": "http://auth:8080",
    "IntrospectionPath": "/api/v1/oauth/introspect",
    "ClientId": "payment-service",
    "ClientSecret": "change-me-in-production"
  },

  "Payment": {
    "DefaultGateway": "ZarinPal",
    "PublicBaseUrl": "https://payment.example.com",
    "RedirectFromGatewayToUrl": "https://app.example.com/payment-result",
    "ShopCallbackUrl": "https://api.example.com/api/v1/orders/payment-callback",
    "Gateways": {
      "ZarinPal": {
        "MerchantId": "your-zarinpal-merchant-id",
        "IsSandbox": true
      },
      "IdPay": {
        "Api": "your-idpay-api-key",
        "IsTestAccount": true
      },
      "PayIr": {
        "Api": "your-payir-api-key",
        "IsTestAccount": true
      },
      "Zibal": {
        "Merchant": "your-zibal-merchant-id"
      },
      "Snapp": {
        "ApiKey": "your-snapp-api-key",
        "TerminalId": "your-terminal-id"
      }
    },
    "Polly": {
      "RetryCount": 3,
      "TimeoutSeconds": 30
    },
    "Standalone": {
      "Enabled": true,
      "DefaultTenantId": "00000000-0000-0000-0000-000000000001",
      "DefaultApplicationCode": "payment"
    },
    "Security": {
      "AllowAuthDisabledInProduction": false
    }
  },

  "RedisLock": {
    "ConnectionString": "redis:6379,abortConnect=false",
    "DefaultExpiry": "00:00:30",
    "DefaultWait": "00:00:10",
    "DefaultRetry": "00:00:00.200",
    "KeyPrefix": "payment:lock:"
  },

  "Outbox": {
    "DispatcherEnabled": true,
    "BatchSize": 50,
    "PollIntervalSeconds": 5,
    "LockDurationSeconds": 60,
    "RetryBaseDelaySeconds": 10,
    "RetryMaxDelaySeconds": 3600
  },

  "Notifier": {
    "Enabled": false,
    "BaseUrl": "http://notifier:8080",
    "TimeoutSeconds": 10,
    "RetryCount": 3,
    "ApplicationCode": "payment",
    "SendInAppNotifications": true,
    "FailPaymentOperationOnNotificationFailure": false,
    "UseOutbox": true,
    "_comment_admin_ids": "Add real admin UUIDs here for admin notifications (refund_requested_admin, etc.) to work",
    "AdminUserIds": []
  }
}
